{
    "name": "@mat3ra/fixtures",
    "version": "0.0.0",
    "description": "Fixtures for common applications, formats, and databases. Exports data folder for programmatic access.",
    "author": "Exabyte Inc.",
    "license": "ISC",
    "main": "dist/js/index.js",
    "types": "dist/js/index.d.ts",
    "files": [
        "dist",
        "data",
        "src/js",
        "tsconfig.json"
    ],
    "exports": {
        ".": {
            "types": "./dist/js/index.d.ts",
            "default": "./dist/js/index.js"
        },
        "./data": "./data",
        "./data/*": "./data/*"
    },
    "dependencies": {
        "ts-node": "^10.9.1",
        "typescript": "^5.0.2"
    },
    "devDependencies": {
        "@exabyte-io/eslint-config": "^2025.1.15-0",
        "@mat3ra/tsconfig": "^2024.6.3-0",
        "@types/chai": "^4.3.5",
        "@types/mocha": "^10.0.1",
        "@types/node": "^20.4.2",
        "@typescript-eslint/eslint-plugin": "^5.56.0",
        "@typescript-eslint/parser": "^5.56.0",
        "babel-eslint": "^10.1.0",
        "chai": "^4.3.4",
        "eslint": "7.32.0",
        "eslint-config-airbnb": "^19.0.4",
        "eslint-config-prettier": "^8.10.0",
        "eslint-import-resolver-exports": "^1.0.0-beta.5",
        "eslint-plugin-import": "^2.30.0",
        "eslint-plugin-jsdoc": "^50.6.0",
        "eslint-plugin-jsx-a11y": "^6.10.0",
        "eslint-plugin-mui-path-imports": "^0.0.15",
        "eslint-plugin-prettier": "^4.2.1",
        "eslint-plugin-react": "^7.37.1",
        "eslint-plugin-simple-import-sort": "^7.0.0",
        "husky": "^7.0.4",
        "lint-staged": "^12.1.2",
        "mocha": "10.3.0",
        "nyc": "^15.1.0",
        "prettier": "^2.7.1"
    },
    "scripts": {
        "lint": "eslint --cache src/js tests/js && prettier --write src/js tests/js",
        "lint:fix": "eslint --fix --cache src/js tests/js && prettier --write src/js tests/js",
        "lint:staged": "lint-staged",
        "prepare": "husky install || exit 0",
        "prettier": "prettier --check src/js tests/js",
        "test": "TS_NODE_PROJECT=tests/tsconfig.json nyc --reporter=text mocha --recursive --bail tests/js",
        "transpile": "tsc"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "lint-staged": {
        "*.{js,ts,tsx}": "eslint --cache --fix",
        "*.{js,ts,tsx,css}": "prettier --write"
    }
}
